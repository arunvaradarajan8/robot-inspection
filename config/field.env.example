# Copy this file to config/field.env and fill in site-specific values.
# config/field.env is ignored by git because it contains credentials.
#
# The field pipeline. Run it with:
#
#   ./scripts/run_field.sh mission
#
#   Oak-D depth camera            -> the occupancy map
#   frontier planner              -> explores to map a bounded radius,
#                                    fastest-payoff frontier first
#   scan planner                  -> ranks map vantages by openness and
#                                    centrality, scans the best few
#   Trimble X7                    -> triggered at each chosen vantage,
#                                    scans stay on its SD card until the end
#   mission manager               -> explore, then scan, then walk back to
#                                    the start pose and wait for the E57
#
# No object detection is involved in where the robot goes. Nothing the
# Trimble produces feeds localization, mapping, or planning.

# ---- Spot connection (localization and motion) ----
SPOT_IP=192.168.80.3
SPOT_USERNAME=
SPOT_PASSWORD=

# Publish Spot's world pose as the mission TF.
SPOT_LOCALIZATION=true
SPOT_ODOM_TOPIC=/spot/odom
# 'vision' is drift-corrected and is what makes the walk home land on the
# start pose after a long excursion. 'odom' is smoother but drifts.
SPOT_FRAME=vision
ROBOT_WORLD_FRAME=vision
NAVIGATION_BASE_FRAME=body

# ---- Fused localization (Spot vision + navX IMU + depth VIO) ----
# Off by default: Spot's vision frame alone already walks the robot home.
# Turn this on to fuse an EKF over Spot's pose, a navX IMU, and the depth
# camera's visual odometry for a steadier estimate. When true the Spot
# bridge streams odometry only and the EKF owns the world->base TF.
# Verify robot_localization and the navX bridge on the Jetson first.
FUSED_LOCALIZATION=false
# navX IMU bridge. 'relay' republishes an Imu topic another driver already
# publishes (NAVX_INPUT_IMU_TOPIC); 'serial' reads the navX over USB/UART.
NAVX_IMU=false
NAVX_MODE=relay
NAVX_IMU_TOPIC=/navx/imu
NAVX_INPUT_IMU_TOPIC=/navx/imu_raw
NAVX_SERIAL_PORT=/dev/ttyACM0
NAVX_SERIAL_BAUD=115200

# ---- Depth camera (Oak-D Pro) ----
# The only sensor that builds the map. Any depth camera works; the defaults
# below match a Luxonis OAK depthai_ros setup.
IMAGE_TOPIC=/oak/rgb/image_raw
# The camera's point cloud, the occupancy map's only input. If the
# driver only publishes a depth image, run depth_image_proc to produce
# this topic.
MAP_DEPTH_ENABLED=true
MAP_DEPTH_POINTS_TOPIC=/depth/points
# Past a few metres stereo depth is too noisy to write free space with, so
# returns beyond this range are dropped from the map.
MAP_DEPTH_MAX_RANGE_M=5.0
MAP_DEPTH_SENSOR_FRAME=

# Depth-camera VIO as the localization source. Off: Spot's vision frame
# is steadier over a long mission. Set ROBOT_WORLD_FRAME=depth_odom too
# if you turn this on.
DEPTH_LOCALIZATION=false
DEPTH_ODOM_TOPIC=/oak/odom
DEPTH_ODOM_FRAME=depth_odom
DEPTH_ODOM_BASE_FRAME=body
DEPTH_ODOM_USE_MESSAGE_FRAME_IDS=false

# ---- Motion ----
# Keep false until Spot is on the mission LAN and the operator allows the
# payload to command motion. Backends: dry_run, nav2, http, spot_sdk.
ROBOT_GOAL_BRIDGE=false
ROBOT_GOAL_BACKEND=spot_sdk
SPOT_COMMAND_URL=
SPOT_COMMAND_FRAME=vision
SPOT_GOAL_DURATION_SEC=30.0
SPOT_ARRIVAL_TIMEOUT_SEC=45.0
SPOT_AUTO_POWER_ON=false
SPOT_STAND_BEFORE_MOVE=true

# ---- Mission lifecycle ----
MISSION_MANAGER=true
MISSION_SUMMARY_PATH=/tmp/mission_summary.yaml
# Any one of these ends exploration and starts the scan phase. 0 disables.
# Keep the excursion cap >= EXPLORATION_RADIUS_M so the robot can reach the
# frontiers it is allowed to map.
MISSION_MAX_STATIONS=0
MISSION_MAX_EXCURSION_M=40.0
MISSION_DURATION_SEC=0.0
# How close to the recorded start pose counts as home.
MISSION_HOME_POSITION_TOLERANCE_M=1.0

# ---- Trimble X7 (trigger only) ----
# The Windows Perspective bridge starts scans and reports when they
# finish. Scans are never transferred during the mission; the operator
# uploads the E57 from the scanner's SD card at the end.
TRIMBLE_WINDOWS_BRIDGE=true
TRIMBLE_WINDOWS_URL=http://192.168.1.50:8765
TRIMBLE_REFERENCE_SCAN_ON_START=true
# Release the robot if the bridge never reports a scan finished.
TRIMBLE_SCAN_TIMEOUT_SEC=300.0
# Legacy folder ingest. The map no longer comes from Trimble scans, so
# this stays off outside offline debugging.
TRIMBLE_SCAN_WATCHER=false
TRIMBLE_SCAN_DIRECTORY=/tmp/trimble_scans
TRIMBLE_SCAN_TOPIC=/trimble/x7/scan_points
FRAME_ANCHOR=false

# ---- Scan planner (phase 2: where to scan) ----
# After exploration, free cells on the finished map are scored by openness
# (clearance for the tripod, broad sightlines) times centrality (closeness
# to the mapped structure). The best few well-separated cells are scanned.
SCAN_PLANNER=true
# How many scan stations to take, and how far apart they must be so the
# scans cover different parts of the site.
SCAN_MAX_STATIONS=3
SCAN_MIN_SEPARATION_M=8.0
# A vantage must be at least this open (free fraction within the radius).
SCAN_OPENNESS_RADIUS_M=3.0
SCAN_MIN_OPENNESS=0.6
# Falloff of the centrality term, in metres from the structure centroid.
SCAN_CENTRALITY_SCALE_M=10.0
# Give up on a scan station if the X7 never reports finished.
SCAN_WAIT_TIMEOUT_SEC=300.0

# ---- Frontier planner (phase 1: where to explore) ----
INFRASTRUCTURE_PLANNER=true
INFRASTRUCTURE_GOAL_COOLDOWN_SEC=20.0
# Map only within this radius of the mission start pose, then stop.
EXPLORATION_RADIUS_M=40.0
# Cost/utility decay in metres. Smaller keeps the robot greedy and nearby
# (faster); larger tolerates longer drives for bigger frontiers.
PLANNER_TRAVEL_DECAY_M=8.0
DIGITAL_TWIN_ACCUMULATE=true
DIGITAL_TWIN_USE_TF_SCAN_ORIGIN=true

# Arrival is verified with the localized TF pose before another Trimble
# scan is requested.
ARRIVAL_CHECK_SOURCE=tf
ARRIVAL_BASE_FRAME=body
ARRIVAL_POSITION_TOLERANCE_M=0.35
ARRIVAL_YAW_TOLERANCE_RAD=0.45
ARRIVAL_STABLE_SEC=1.5

# ---- Demo mode (./scripts/run_field.sh demo) ----
# The real robot, the real X7, an invented site: a predefined 3D point
# cloud anchored at the robot's pose when the demo launched replaces the
# depth camera. The robot walks to the defects planted
# in it and triggers a real scan at each one, in an area that is actually
# empty. Only the settings below apply; the mission uses the ones above.
#
# SAFETY: nothing in the stack knows about real obstacles in demo mode.
# Use a large open area and keep a spotter on the e-stop.
DEMO_SITE_PATH=
DEMO_SITE_DENSITY=1.0
# How far the simulated sensor sees, and how close the robot has to get
# before a planted defect becomes a detection.
DEMO_SENSOR_RANGE_M=20.0
DEMO_DETECTION_RANGE_M=8.0
DEMO_DETECTION_FOV_DEG=90.0
# Anchoring. By default the site is placed at the robot's pose when the
# demo starts, so you walk Spot to the middle of the clear area first.
DEMO_ANCHOR_TO_START_POSE=true
DEMO_ANCHOR_X=0.0
DEMO_ANCHOR_Y=0.0
DEMO_ANCHOR_YAW_DEG=0.0
# Keep the leash well inside the clear area.
DEMO_MAX_EXCURSION_M=20.0
DEMO_EXPLORATION_RADIUS_M=20.0
DEMO_SCAN_MIN_SEPARATION_M=4.0
DEMO_ROOT=/tmp/demo_site

ENABLE_RVIZ=true
ROS_DOMAIN_ID=42
