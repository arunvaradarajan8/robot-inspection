<?xml version="1.0"?>
<!--
  Full pipeline demo in Gazebo (gz-sim / Harmonic). No hardware required.

    ros2 launch defect_detection gazebo_sim.launch.xml

  Gazebo simulates the robot, the OAK-D RGBD camera, and the inspection
  site (world generated from the shared synthetic-world constants). A
  ground-truth sim node stands in for the Trimble X7; every other node is
  the real production node, running on /clock sim time. Navigation is
  frontier exploration then map-vantage scanning - no object detection.

  Requires: sudo apt install ros-jazzy-ros-gz
-->
<launch>
  <arg name="rviz" default="true"
       description="Open RViz with the demo layout."/>
  <arg name="gui" default="true"
       description="Run the Gazebo GUI; false runs the sim server headless."/>
  <arg name="demo_root" default="/tmp/synthetic_demo"
       description="Scratch directory for scans and the mission summary."/>
  <arg name="world"
       default="$(find-pkg-share defect_detection)/worlds/inspection_site.sdf"/>
  <arg name="exploration_radius_m" default="12.0"
       description="Bounded exploration for the 16m-wide simulated wall."/>
  <arg name="digital_twin_accumulate" default="true"/>
  <arg name="digital_twin_use_tf_scan_origin" default="false"/>

  <!-- Gazebo stamps everything with sim time; every ROS node must follow. -->
  <set_parameter name="use_sim_time" value="true"/>

  <executable if="$(var gui)"
              cmd="gz sim -r $(var world)"
              output="screen"/>
  <executable unless="$(var gui)"
              cmd="gz sim -r -s --headless-rendering $(var world)"
              output="screen"/>

  <node pkg="ros_gz_bridge"
        exec="parameter_bridge"
        name="gazebo_bridge"
        output="screen">
    <param name="config_file"
           value="$(find-pkg-share defect_detection)/config/gazebo_bridge.yaml"/>
  </node>

  <!-- Camera optical frame: matches the <gz_frame_id> of the RGBD sensor
       and its mounting pose on the robot in the generated world. -->
  <node pkg="tf2_ros"
        exec="static_transform_publisher"
        name="camera_optical_tf"
        args="--x 0.25 --y 0 --z 0.65 --roll -1.5708 --pitch 0 --yaw -1.5708 --frame-id base_link --child-frame-id camera_optical_frame"
        output="screen"/>

  <!-- Sim stand-ins: the Trimble X7 and the robot's motion backend. -->
  <node pkg="defect_detection"
        exec="sim_scan_node"
        name="sim_scan_node"
        output="screen">
    <param name="scan_directory" value="$(var demo_root)/trimble_scans"/>
  </node>

  <node pkg="defect_detection"
        exec="goal_driver_node"
        name="goal_driver_node"
        output="screen"/>

  <!-- The real production pipeline. -->
  <include file="$(find-pkg-share defect_detection)/launch/defect_detection.launch.xml">
    <arg name="publish_camera" value="false"/>
    <arg name="visualization" value="true"/>
    <!-- Trigger-only X7, as in the field: the sim writes a LAS to stand in
         for the scanner's SD card and nothing reads it back. -->
    <arg name="trimble_scan_watcher" value="false"/>
    <arg name="trimble_scan_directory" value="$(var demo_root)/trimble_scans"/>
    <arg name="digital_twin_map" value="true"/>
    <!-- The simulated cloud feeds the long-range cloud source; Gazebo has
         no second sensor to fuse, so the depth source stays off. -->
    <arg name="map_cloud_enabled" value="true"/>
    <arg name="map_cloud_topic" value="/cloud/points"/>
    <arg name="map_depth_enabled" value="false"/>
    <arg name="frame_anchor" value="false"/>
    <arg name="anchor_store_path" value="$(var demo_root)/anchor.yaml"/>

    <!-- Frontier exploration, then map-vantage scanning, then walk home. -->
    <arg name="infrastructure_planner" value="true"/>
    <arg name="exploration_radius_m" value="$(var exploration_radius_m)"/>
    <arg name="scan_planner" value="true"/>
    <!-- The sim wall is only 16m wide; tighten vantage spacing. -->
    <arg name="scan_min_separation_m" value="2.0"/>
    <arg name="scan_openness_radius_m" value="1.5"/>
    <arg name="scan_min_openness" value="0.4"/>
    <arg name="mission_manager" value="true"/>
    <arg name="mission_summary_path" value="$(var demo_root)/mission.yaml"/>
    <arg name="mission_max_excursion_m" value="12.0"/>
    <arg name="robot_goal_bridge" value="true"/>
    <arg name="robot_goal_backend" value="dry_run"/>
    <arg name="arrival_base_frame" value="base_link"/>
    <arg name="digital_twin_accumulate"
         value="$(var digital_twin_accumulate)"/>
    <arg name="digital_twin_use_tf_scan_origin"
         value="$(var digital_twin_use_tf_scan_origin)"/>
    <arg name="rviz" value="false"/>
  </include>

  <node if="$(var rviz)"
        pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        args="-d $(find-pkg-share defect_detection)/config/synthetic_demo.rviz"
        output="screen"/>
</launch>
