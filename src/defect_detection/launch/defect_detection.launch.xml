<?xml version="1.0"?>
<launch>
  <arg name="publish_camera" default="true"
       description="Publish frames from the local camera."/>
  <arg name="camera_index" default="0"
       description="OpenCV/V4L2 camera device index."/>
  <arg name="camera_frame" default="camera_optical_frame"
       description="Frame ID attached to camera images."/>
  <arg name="camera_frame_rate" default="30.0"
       description="Requested camera publication rate."/>
  <arg name="camera_reconnect_interval_sec" default="2.0"/>
  <arg name="detector" default="false"
       description="Run YOLO. Requires ultralytics and models/yolov11m.engine."/>
  <arg name="dataset_path"
       default="$(find-pkg-share defect_detection)/models/dataset.yaml"/>
  <arg name="model_path"
       default="$(find-pkg-share defect_detection)/models/yolov11m.engine"/>
  <arg name="image_topic" default="/ros2_image"/>
  <arg name="detections_2d_topic" default="/detections_2d"/>
  <arg name="pointcloud_topic" default="/cloud/points"/>
  <arg name="detections_3d_topic" default="/detections_3d"/>
  <arg name="depth_navigation" default="false"
       description="Use the depth camera to turn 2D detections into navigation-ready 3D detections."/>
  <arg name="depth_topic" default="/oak/rgb/depth"/>
  <arg name="depth_camera_info_topic" default="/oak/rgb/camera_info"/>
  <arg name="depth_minimum_confidence" default="0.50"/>
  <arg name="depth_bbox_padding_px" default="4"/>
  <arg name="depth_default_bbox_size_m" default="0.20"/>
  <arg name="depth_localization" default="false"
       description="Use depth-camera visual odometry/VSLAM as the localization source. Off by default: Spot's own vision frame is the mission frame."/>
  <arg name="depth_odom_topic" default="/oak/odom"/>
  <arg name="depth_odom_frame" default="depth_odom"/>
  <arg name="depth_odom_base_frame" default="body"/>
  <arg name="depth_odom_use_message_frame_ids" default="true"/>
  <arg name="visualization" default="true"
       description="Republish the cloud and convert 3D detections to RViz markers."/>
  <arg name="rviz" default="false"
       description="Open RViz with the point-cloud and marker displays configured."/>
  <arg name="visualization_pointcloud_topic" default="/rviz/pointcloud"/>
  <arg name="markers_topic" default="/detection_markers"/>
  <arg name="box_alpha" default="0.30"/>
  <arg name="label_height" default="0.15"/>
  <arg name="marker_lifetime_sec" default="0.50"/>
  <arg name="navigation_target_frame" default="map"/>
  <arg name="navigation_base_frame" default="base_link"/>
  <arg name="navigation_standoff_distance" default="1.50"/>
  <arg name="sync_queue_size" default="30"
       description="Number of detection and cloud messages retained for matching."/>
  <arg name="sync_slop_sec" default="0.10"
       description="Maximum camera/point-cloud acquisition-time difference."/>
  <arg name="trimble_scan_watcher" default="false"
       description="Watch a folder for completed Trimble X7 LAS/LAZ scans."/>
  <arg name="trimble_scan_directory" default="/tmp/trimble_scans"/>
  <arg name="trimble_scan_topic" default="/trimble/x7/scan_points"/>
  <arg name="trimble_scan_frame" default="map"/>
  <arg name="trimble_scan_max_points" default="500000"/>
  <arg name="trimble_require_scan_request" default="true"/>
  <arg name="scan_decision" default="false"
       description="Request X7 scans only for high-confidence detections."/>
  <arg name="scan_mode" default="coverage"
       description="X7 trigger: 'coverage' scans at every waypoint the planner stopped at; 'detection' additionally requires live high-confidence YOLO detections."/>
  <arg name="scan_request_initial" default="true"
       description="Request a reference scan on startup."/>
  <arg name="scan_complete_topic" default="/digital_twin/scan_complete"
       description="Reported by the Windows bridge; the X7 keeps its scans on its own SD card, so nothing returns over ROS."/>
  <arg name="scan_required_topic" default="/digital_twin/scan_required"/>
  <arg name="scan_reason_topic" default="/digital_twin/scan_reason"/>
  <arg name="scan_confidence_threshold" default="0.65"/>
  <arg name="scan_min_detections" default="1"/>
  <arg name="scan_cooldown_sec" default="60.0"/>
  <arg name="min_scan_separation_m" default="10.0"
       description="Skip scans closer than this to a previous scan location."/>
  <arg name="digital_twin_map" default="false"
       description="Build a 2D occupancy map from the depth camera (and, in sim/demo, a long-range cloud source)."/>
  <arg name="digital_twin_map_topic" default="/digital_twin/map"/>
  <arg name="digital_twin_map_resolution" default="0.10"/>
  <arg name="digital_twin_scan_origin_x" default="0.0"/>
  <arg name="digital_twin_scan_origin_y" default="0.0"/>
  <arg name="digital_twin_accumulate" default="true"
       description="Merge every observation into one persistent occupancy map."/>
  <arg name="digital_twin_use_tf_scan_origin" default="true"
       description="Raytrace from each sensor's own pose rather than a fixed origin."/>
  <!-- Optional long-range cloud source: off in the field (depth only);
       the simulator and demo enable it to feed their world cloud in. -->
  <arg name="map_cloud_enabled" default="false"/>
  <arg name="map_cloud_topic" default="/cloud/points"/>
  <arg name="map_cloud_min_z" default="-0.25"/>
  <arg name="map_cloud_max_z" default="1.20"/>
  <arg name="map_cloud_max_range_m" default="40.0"/>
  <arg name="map_cloud_max_points_per_update" default="40000"/>
  <arg name="map_cloud_sensor_frame" default=""/>
  <arg name="map_cloud_update_period_sec" default="0.5"/>
  <!-- Depth camera: short range and dense, the field map's backbone. -->
  <arg name="map_depth_enabled" default="true"/>
  <arg name="map_depth_points_topic" default="/depth/points"/>
  <arg name="map_depth_min_z" default="-0.25"/>
  <arg name="map_depth_max_z" default="1.20"/>
  <arg name="map_depth_max_range_m" default="5.0"/>
  <arg name="map_depth_max_points_per_update" default="20000"/>
  <arg name="map_depth_sensor_frame" default=""/>
  <arg name="map_depth_update_period_sec" default="0.5"/>
  <arg name="waypoint_arrived_topic" default="/digital_twin/waypoint_arrived"/>
  <arg name="frame_anchor" default="false"
       description="Legacy: anchored the twin map frame to the robot world frame when Trimble scans built the map. The map is now built directly in Spot's world frame, so no anchoring step exists."/>
  <arg name="robot_world_frame" default="vision"/>
  <arg name="anchor_request_topic" default="/digital_twin/anchor_request"/>
  <arg name="anchor_store_path" default="/tmp/digital_twin_anchor.yaml"/>
  <arg name="auto_anchor_on_first_scan" default="true"/>
  <arg name="infrastructure_planner" default="true"
       description="Plan generic inspection/rescan station goals."/>
  <arg name="infrastructure_goal_topic"
       default="/infrastructure/inspection_goal"/>
  <arg name="infrastructure_goal_cooldown_sec" default="20.0"/>
  <arg name="prefer_defect_rescans" default="true"
       description="Visit defect rescan goals before map frontiers."/>
  <arg name="planner_hold_for_scan" default="true"
       description="Stand still between a scan request and the scanner reporting it finished."/>
  <arg name="planner_scan_wait_timeout_sec" default="300.0"/>
  <arg name="allow_exploration_topic" default="/mission/allow_exploration"/>
  <arg name="spot_localization" default="false"
       description="Publish Spot's world pose as the mission TF via the Boston Dynamics SDK."/>
  <arg name="spot_frame" default="vision"
       description="Spot world frame: 'vision' is drift-corrected and is what makes the walk home land accurately; 'odom' is smooth but drifts."/>
  <arg name="spot_odom_topic" default="/spot/odom"/>
  <arg name="spot_odom_publish_rate_hz" default="10.0"/>
  <arg name="spot_publish_tf" default="true"
       description="Let the Spot bridge broadcast world->base TF. Set false when fused_localization is on so the EKF owns the transform."/>
  <!-- Fused localization: an EKF (robot_localization) blends Spot's
       vision-frame pose, the navX IMU, and depth-camera visual odometry
       into one drift-corrected map->base_link transform. When on, the
       Spot bridge publishes odometry only and the EKF owns the TF. -->
  <arg name="fused_localization" default="false"
       description="Fuse Spot vision pose + navX IMU + depth VIO through an EKF for the mission TF."/>
  <arg name="ekf_config"
       default="$(find-pkg-share defect_detection)/config/ekf.yaml"/>
  <arg name="fused_world_frame" default="vision"
       description="Frame the EKF localizes in; must match robot_world_frame."/>
  <arg name="navx_imu" default="false"
       description="Run the navX IMU bridge that publishes sensor_msgs/Imu for the EKF."/>
  <arg name="navx_imu_topic" default="/navx/imu"/>
  <arg name="navx_imu_frame" default="navx_imu"/>
  <arg name="navx_mode" default="relay"
       description="'relay' republishes an existing Imu topic; 'serial' reads a navX over a serial port."/>
  <arg name="navx_input_imu_topic" default="/navx/imu_raw"/>
  <arg name="navx_serial_port" default="/dev/ttyACM0"/>
  <arg name="navx_serial_baud" default="115200"/>
  <!-- Where the navX board sits on the robot, base_frame -> navx_imu_frame.
       The EKF needs this to bring IMU data into the base frame. Defaults to
       identity; set it to your actual mount pose. -->
  <arg name="navx_x" default="0.0"/>
  <arg name="navx_y" default="0.0"/>
  <arg name="navx_z" default="0.0"/>
  <arg name="navx_roll" default="0.0"/>
  <arg name="navx_pitch" default="0.0"/>
  <arg name="navx_yaw" default="0.0"/>
  <!-- Mission lifecycle: explore, walk home, wait for the E57 upload. -->
  <arg name="mission_manager" default="false"
       description="Own the mission lifecycle and return the robot to its start pose."/>
  <arg name="mission_state_topic" default="/mission/state"/>
  <arg name="mission_return_home_topic" default="/mission/return_home"/>
  <arg name="mission_upload_complete_topic" default="/mission/upload_complete"/>
  <arg name="mission_summary_path" default="/tmp/mission_summary.yaml"/>
  <arg name="mission_max_stations" default="0"/>
  <arg name="mission_max_excursion_m" default="30.0"/>
  <arg name="mission_duration_sec" default="0.0"/>
  <arg name="mission_no_frontier_patience_sec" default="60.0"/>
  <arg name="mission_breadcrumb_min_spacing_m" default="2.0"/>
  <arg name="mission_return_leg_timeout_sec" default="90.0"/>
  <arg name="mission_home_position_tolerance_m" default="1.0"/>
  <arg name="robot_goal_bridge" default="false"
       description="Send inspection goals to a robot backend."/>
  <arg name="robot_goal_backend" default="dry_run"/>
  <arg name="spot_command_url" default=""/>
  <arg name="spot_ip" default=""/>
  <arg name="spot_username" default=""/>
  <arg name="spot_password" default=""/>
  <arg name="spot_command_frame" default="odom"/>
  <arg name="spot_goal_duration_sec" default="30.0"/>
  <arg name="spot_arrival_timeout_sec" default="45.0"/>
  <arg name="spot_auto_power_on" default="false"/>
  <arg name="spot_stand_before_move" default="true"/>
  <arg name="arrival_check_source" default="tf"/>
  <arg name="arrival_base_frame" default="body"/>
  <arg name="arrival_position_tolerance_m" default="0.35"/>
  <arg name="arrival_yaw_tolerance_rad" default="0.45"/>
  <arg name="arrival_stable_sec" default="1.5"/>
  <arg name="trimble_windows_bridge" default="false"
       description="Notify the Windows Perspective bridge about scan requests and waypoint arrivals."/>
  <arg name="trimble_windows_url" default="http://127.0.0.1:8765"/>
  <arg name="trimble_reference_scan_on_start" default="true"/>
  <arg name="trimble_camera_preview" default="true"/>
  <arg name="trimble_camera_preview_rate_hz" default="2.0"/>
  <arg name="trimble_camera_preview_width" default="640"/>
  <arg name="trimble_scan_timeout_sec" default="300.0"
       description="Release the robot if the Windows bridge never reports the scan finished."/>
  <arg name="defect_map" default="false"
       description="Persist AI defect markers for the digital twin."/>
  <arg name="defect_map_store_path"
       default="/tmp/digital_twin_defects.yaml"/>
  <arg name="defect_map_markers_topic"
       default="/digital_twin/defect_markers"/>
  <arg name="defect_map_minimum_confidence" default="0.50"/>
  <arg name="defect_rescan_goals_topic"
       default="/digital_twin/rescan_goals"/>

  <node if="$(var publish_camera)"
        pkg="defect_detection"
        exec="image_publisher"
        name="image_publisher"
        output="screen">
    <param name="camera_index" value="$(var camera_index)"/>
    <param name="frame_id" value="$(var camera_frame)"/>
    <param name="frame_rate" value="$(var camera_frame_rate)"/>
    <param name="reconnect_interval_sec"
           value="$(var camera_reconnect_interval_sec)"/>
  </node>

  <node if="$(var detector)"
        pkg="defect_detection"
        exec="yolo_detector"
        name="yolo_node"
        output="screen">
    <param name="dataset_path" value="$(var dataset_path)"/>
    <param name="model_path" value="$(var model_path)"/>
    <param name="image_topic" value="$(var image_topic)"/>
    <param name="detections_topic" value="$(var detections_2d_topic)"/>
  </node>

  <node if="$(var depth_navigation)"
        pkg="defect_detection"
        exec="depth_fusion_node"
        name="depth_detection_fusion"
        output="screen">
    <param name="detections_2d_topic" value="$(var detections_2d_topic)"/>
    <param name="depth_topic" value="$(var depth_topic)"/>
    <param name="camera_info_topic" value="$(var depth_camera_info_topic)"/>
    <param name="detections_3d_topic" value="$(var detections_3d_topic)"/>
    <param name="minimum_confidence"
           value="$(var depth_minimum_confidence)"/>
    <param name="bbox_padding_px" value="$(var depth_bbox_padding_px)"/>
    <param name="default_bbox_size_m"
           value="$(var depth_default_bbox_size_m)"/>
    <param name="sync_queue_size" value="$(var sync_queue_size)"/>
    <param name="sync_slop_sec" value="$(var sync_slop_sec)"/>
  </node>

  <node if="$(var depth_localization)"
        pkg="defect_detection"
        exec="depth_localization_bridge"
        name="depth_localization_bridge"
        output="screen">
    <param name="odom_topic" value="$(var depth_odom_topic)"/>
    <param name="odom_frame" value="$(var depth_odom_frame)"/>
    <param name="base_frame" value="$(var depth_odom_base_frame)"/>
    <param name="use_message_frame_ids"
           value="$(var depth_odom_use_message_frame_ids)"/>
  </node>

  <node if="$(var visualization)"
        pkg="defect_detection"
        exec="visualization_node"
        name="detection_visualization_node"
        output="screen">
    <param name="visualization_pointcloud_topic"
           value="$(var visualization_pointcloud_topic)"/>
    <param name="pointcloud_topic" value="$(var pointcloud_topic)"/>
    <param name="detections_topic" value="$(var detections_3d_topic)"/>
    <param name="markers_topic" value="$(var markers_topic)"/>
    <param name="box_alpha" value="$(var box_alpha)"/>
    <param name="label_height" value="$(var label_height)"/>
    <param name="marker_lifetime_sec" value="$(var marker_lifetime_sec)"/>
  </node>

  <node if="$(var rviz)"
        pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        args="-d $(find-pkg-share defect_detection)/config/defect_visualization.rviz"
        output="screen"/>

  <node if="$(var trimble_scan_watcher)"
        pkg="defect_detection"
        exec="trimble_scan_watcher"
        name="trimble_scan_watcher"
        output="screen">
    <param name="scan_directory" value="$(var trimble_scan_directory)"/>
    <param name="output_topic" value="$(var trimble_scan_topic)"/>
    <param name="frame_id" value="$(var trimble_scan_frame)"/>
    <param name="max_points" value="$(var trimble_scan_max_points)"/>
    <param name="require_scan_request"
           value="$(var trimble_require_scan_request)"/>
    <param name="scan_required_topic" value="$(var scan_required_topic)"/>
  </node>

  <node if="$(var scan_decision)"
        pkg="defect_detection"
        exec="scan_decision_node"
        name="digital_twin_scan_decision"
        output="screen">
    <param name="mode" value="$(var scan_mode)"/>
    <param name="waypoint_arrived_topic" value="$(var waypoint_arrived_topic)"/>
    <param name="request_initial_scan" value="$(var scan_request_initial)"/>
    <param name="detections_topic" value="$(var detections_2d_topic)"/>
    <param name="scan_required_topic" value="$(var scan_required_topic)"/>
    <param name="scan_reason_topic" value="$(var scan_reason_topic)"/>
    <param name="confidence_threshold"
           value="$(var scan_confidence_threshold)"/>
    <param name="min_detections" value="$(var scan_min_detections)"/>
    <param name="scan_cooldown_sec" value="$(var scan_cooldown_sec)"/>
    <param name="min_scan_separation_m" value="$(var min_scan_separation_m)"/>
    <param name="target_frame" value="$(var navigation_target_frame)"/>
    <param name="base_frame" value="$(var navigation_base_frame)"/>
  </node>

  <node if="$(var digital_twin_map)"
        pkg="defect_detection"
        exec="pointcloud_to_occupancy"
        name="pointcloud_to_occupancy"
        output="screen">
    <param name="map_topic" value="$(var digital_twin_map_topic)"/>
    <param name="resolution" value="$(var digital_twin_map_resolution)"/>
    <param name="scan_origin_x" value="$(var digital_twin_scan_origin_x)"/>
    <param name="scan_origin_y" value="$(var digital_twin_scan_origin_y)"/>
    <param name="accumulate" value="$(var digital_twin_accumulate)"/>
    <param name="use_tf_scan_origin"
           value="$(var digital_twin_use_tf_scan_origin)"/>
    <param name="target_frame" value="$(var navigation_target_frame)"/>
    <param name="base_frame" value="$(var navigation_base_frame)"/>
    <param name="cloud_enabled" value="$(var map_cloud_enabled)"/>
    <param name="cloud_topic" value="$(var map_cloud_topic)"/>
    <param name="cloud_min_z" value="$(var map_cloud_min_z)"/>
    <param name="cloud_max_z" value="$(var map_cloud_max_z)"/>
    <param name="cloud_max_range_m" value="$(var map_cloud_max_range_m)"/>
    <param name="cloud_max_points_per_update"
           value="$(var map_cloud_max_points_per_update)"/>
    <param name="cloud_sensor_frame" value="$(var map_cloud_sensor_frame)"/>
    <param name="cloud_update_period_sec"
           value="$(var map_cloud_update_period_sec)"/>
    <param name="depth_enabled" value="$(var map_depth_enabled)"/>
    <param name="depth_topic" value="$(var map_depth_points_topic)"/>
    <param name="depth_min_z" value="$(var map_depth_min_z)"/>
    <param name="depth_max_z" value="$(var map_depth_max_z)"/>
    <param name="depth_max_range_m" value="$(var map_depth_max_range_m)"/>
    <param name="depth_max_points_per_update"
           value="$(var map_depth_max_points_per_update)"/>
    <param name="depth_sensor_frame" value="$(var map_depth_sensor_frame)"/>
    <param name="depth_update_period_sec"
           value="$(var map_depth_update_period_sec)"/>
  </node>

  <!-- navX IMU: a sensor_msgs/Imu source for the fused-localization EKF. -->
  <node if="$(var navx_imu)"
        pkg="defect_detection"
        exec="navx_imu_bridge"
        name="navx_imu_bridge"
        output="screen">
    <param name="mode" value="$(var navx_mode)"/>
    <param name="imu_topic" value="$(var navx_imu_topic)"/>
    <param name="frame_id" value="$(var navx_imu_frame)"/>
    <param name="input_imu_topic" value="$(var navx_input_imu_topic)"/>
    <param name="serial_port" value="$(var navx_serial_port)"/>
    <param name="serial_baud" value="$(var navx_serial_baud)"/>
  </node>

  <node if="$(var navx_imu)"
        pkg="tf2_ros"
        exec="static_transform_publisher"
        name="navx_mount_static_transform"
        args="--x $(var navx_x) --y $(var navx_y) --z $(var navx_z) --roll $(var navx_roll) --pitch $(var navx_pitch) --yaw $(var navx_yaw) --frame-id $(var navigation_base_frame) --child-frame-id $(var navx_imu_frame)"
        output="screen"/>

  <!-- Fused localization EKF. Owns the world->base_link TF, so the Spot
       bridge is set to odometry-only (publish_tf=false) below. -->
  <node if="$(var fused_localization)"
        pkg="robot_localization"
        exec="ekf_node"
        name="ekf_localization"
        output="screen">
    <param from="$(var ekf_config)"/>
    <param name="map_frame" value="$(var fused_world_frame)"/>
    <param name="odom_frame" value="$(var fused_world_frame)"/>
    <param name="world_frame" value="$(var fused_world_frame)"/>
    <param name="base_link_frame" value="$(var navigation_base_frame)"/>
    <param name="odom0" value="$(var spot_odom_topic)"/>
    <param name="imu0" value="$(var navx_imu_topic)"/>
    <param name="odom1" value="$(var depth_odom_topic)"/>
  </node>

  <node if="$(var mission_manager)"
        pkg="defect_detection"
        exec="mission_manager"
        name="mission_manager"
        output="screen">
    <param name="target_frame" value="$(var navigation_target_frame)"/>
    <param name="base_frame" value="$(var navigation_base_frame)"/>
    <param name="goal_topic" value="$(var infrastructure_goal_topic)"/>
    <param name="waypoint_arrived_topic"
           value="$(var waypoint_arrived_topic)"/>
    <param name="allow_exploration_topic"
           value="$(var allow_exploration_topic)"/>
    <param name="state_topic" value="$(var mission_state_topic)"/>
    <param name="return_home_topic" value="$(var mission_return_home_topic)"/>
    <param name="upload_complete_topic"
           value="$(var mission_upload_complete_topic)"/>
    <param name="summary_path" value="$(var mission_summary_path)"/>
    <param name="max_stations" value="$(var mission_max_stations)"/>
    <param name="max_excursion_m" value="$(var mission_max_excursion_m)"/>
    <param name="mission_duration_sec" value="$(var mission_duration_sec)"/>
    <param name="no_frontier_patience_sec"
           value="$(var mission_no_frontier_patience_sec)"/>
    <param name="breadcrumb_min_spacing_m"
           value="$(var mission_breadcrumb_min_spacing_m)"/>
    <param name="return_leg_timeout_sec"
           value="$(var mission_return_leg_timeout_sec)"/>
    <param name="home_position_tolerance_m"
           value="$(var mission_home_position_tolerance_m)"/>
  </node>

  <node if="$(var frame_anchor)"
        pkg="defect_detection"
        exec="frame_anchor_node"
        name="digital_twin_frame_anchor"
        output="screen">
    <param name="map_frame" value="$(var navigation_target_frame)"/>
    <param name="robot_world_frame" value="$(var robot_world_frame)"/>
    <param name="base_frame" value="$(var navigation_base_frame)"/>
    <param name="anchor_request_topic" value="$(var anchor_request_topic)"/>
    <param name="scan_topic" value="$(var trimble_scan_topic)"/>
    <param name="store_path" value="$(var anchor_store_path)"/>
    <param name="auto_anchor_on_first_scan"
           value="$(var auto_anchor_on_first_scan)"/>
  </node>

  <node if="$(var infrastructure_planner)"
        pkg="defect_detection"
        exec="infrastructure_planner"
        name="infrastructure_inspection_planner"
        output="screen">
    <param name="enabled" value="true"/>
    <param name="map_topic" value="$(var digital_twin_map_topic)"/>
    <param name="rescan_goals_topic" value="$(var defect_rescan_goals_topic)"/>
    <param name="goal_topic" value="$(var infrastructure_goal_topic)"/>
    <param name="target_frame" value="$(var navigation_target_frame)"/>
    <param name="base_frame" value="$(var navigation_base_frame)"/>
    <param name="standoff_distance_m"
           value="$(var navigation_standoff_distance)"/>
    <param name="goal_cooldown_sec"
           value="$(var infrastructure_goal_cooldown_sec)"/>
    <param name="prefer_defect_rescans"
           value="$(var prefer_defect_rescans)"/>
    <param name="hold_for_scan" value="$(var planner_hold_for_scan)"/>
    <param name="scan_required_topic" value="$(var scan_required_topic)"/>
    <param name="scan_complete_topic" value="$(var scan_complete_topic)"/>
    <param name="waypoint_arrived_topic"
           value="$(var waypoint_arrived_topic)"/>
    <param name="allow_exploration_topic"
           value="$(var allow_exploration_topic)"/>
    <param name="scan_wait_timeout_sec"
           value="$(var planner_scan_wait_timeout_sec)"/>
  </node>

  <node if="$(var spot_localization)"
        pkg="defect_detection"
